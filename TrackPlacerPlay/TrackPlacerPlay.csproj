<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>TrackPlacerPlay</AssemblyName>
		<RootNamespace>TrackPlacer</RootNamespace>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<DefineConstants>$(DefineConstants);TRACKPLACER_RUNTIME</DefineConstants>
		<DvInstallDir Condition="'$(DvInstallDir)' == ''">S:\SteamLibrary\steamapps\common\Derail Valley</DvInstallDir>
		<DvManaged>$(DvInstallDir)\DerailValley_Data\Managed</DvManaged>
		<UmmDll>$(DvManaged)\UnityModManager\UnityModManager.dll</UmmDll>
		<UmmDll Condition="!Exists('$(UmmDll)')">$(DvManaged)\UnityModManager.dll</UmmDll>
		<HarmonyDll>$(DvManaged)\UnityModManager\0Harmony.dll</HarmonyDll>
		<HarmonyDll Condition="!Exists('$(HarmonyDll)')">$(DvManaged)\0Harmony.dll</HarmonyDll>
	</PropertyGroup>

	<Target Name="CheckDvPaths" BeforeTargets="ResolveAssemblyReferences">
		<Error Condition="!Exists('$(DvManaged)\Assembly-CSharp.dll')" Text="Assembly-CSharp.dll nicht gefunden unter $(DvManaged)." />
		<Error Condition="!Exists('$(UmmDll)')" Text="UnityModManager.dll nicht gefunden." />
	</Target>

	<ItemGroup>
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\TrackPlacer\Geometry\*.cs" Link="Geometry\%(Filename)%(Extension)" />
		<Compile Include="..\TrackPlacer\Data\LayoutStore.cs" Link="Data\LayoutStore.cs" />
		<Compile Include="..\TrackPlacer\World\*.cs" Link="World\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Assembly-CSharp"><HintPath>$(DvManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="Newtonsoft.Json"><HintPath>$(DvManaged)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="DV.RailTrack"><HintPath>$(DvManaged)\DV.RailTrack.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="DV.PointSet"><HintPath>$(DvManaged)\DV.PointSet.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="DV.MeshX"><HintPath>$(DvManaged)\DV.MeshX.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="DV.ThingTypes"><HintPath>$(DvManaged)\DV.ThingTypes.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="DV.Utils"><HintPath>$(DvManaged)\DV.Utils.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="BezierCurves"><HintPath>$(DvManaged)\BezierCurves.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="net.smkd.vector3d"><HintPath>$(DvManaged)\net.smkd.vector3d.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="DV.Interaction"><HintPath>$(DvManaged)\DV.Interaction.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="WorldStreamer"><HintPath>$(DvManaged)\WorldStreamer.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="DV.OriginShiftInfo"><HintPath>$(DvManaged)\DV.OriginShiftInfo.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine"><HintPath>$(DvManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine.CoreModule"><HintPath>$(DvManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine.PhysicsModule"><HintPath>$(DvManaged)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine.AnimationModule"><HintPath>$(DvManaged)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(DvManaged)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(DvManaged)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityEngine.IMGUIModule"><HintPath>$(DvManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="0Harmony"><HintPath>$(HarmonyDll)</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityModManager"><HintPath>$(UmmDll)</HintPath><Private>false</Private></Reference>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="..\TrackPlacer\Textures\*.png" Link="Textures\%(Filename)%(Extension)" LogicalName="TrackPlacer.Textures.%(Filename).png" />
		<EmbeddedResource Include="..\TrackPlacer\Models\*.obj" Link="Models\%(Filename)%(Extension)" LogicalName="TrackPlacer.Models.%(Filename).obj" />
		<EmbeddedResource Include="..\TrackPlacer\Textures\*.jpg" Link="Textures\%(Filename)%(Extension)" LogicalName="TrackPlacer.Textures.%(Filename).jpg" />
	</ItemGroup>
	<!-- Nach dem Bauen direkt in den Mods-Ordner kopieren (wie der Editor) -->
	<Target Name="CopyToMods" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
		<MakeDir Directories="$(DvInstallDir)\Mods\TrackPlacerPlay" />
		<Copy SourceFiles="$(TargetPath);Info.json" DestinationFolder="$(DvInstallDir)\Mods\TrackPlacerPlay" ContinueOnError="true" />
	</Target>
</Project>
